#!/usr/bin/env python3
import sys, os, subprocess, time, yaml, json, socket, shutil, urllib.request, urllib.error
from datetime import datetime, timezone
from jinja2 import Template

BASE = os.path.dirname(os.path.abspath(__file__))
MANIFEST = os.path.join(BASE, "manifest.yaml")
TEMPLATES_DIR = os.path.join(BASE, "templates")
NGINX_CONF = os.path.join(BASE, "nginx.conf")
COMPOSE_FILE = os.path.join(BASE, "docker-compose.yml")
HISTORY_FILE = os.path.join(BASE, "history.jsonl")
AUDIT_FILE = os.path.join(BASE, "audit_report.md")

def load_manifest():
    with open(MANIFEST) as f:
        return yaml.safe_load(f)

def run(cmd, check=False, capture=False):
    if capture:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True)
    subprocess.run(cmd, shell=True, check=check)

def get_opa_url():
    cfg = load_manifest()
    port = cfg.get("opa", {}).get("port", 8181)
    return f"http://localhost:{port}"

def query_opa(package, input_data):
    url = f"{get_opa_url()}/v1/data/{package}"
    body = json.dumps({"input": input_data}).encode()
    req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            result = json.loads(resp.read())
            return result.get("result", {})
    except Exception as e:
        return {"error": f"OPA unavailable: {str(e)}"}

def get_host_stats():
    disk = shutil.disk_usage("/")
    disk_free_gb = disk.free / (1024**3)
    try:
        with open("/proc/loadavg") as f:
            cpu_load = float(f.read().split()[0])
    except:
        cpu_load = 0.0
    try:
        with open("/proc/meminfo") as f:
            lines = f.readlines()
        mem_total = next(int(l.split()[1]) for l in lines if l.startswith("MemTotal"))
        mem_free = next(int(l.split()[1]) for l in lines if l.startswith("MemAvailable"))
        mem_free_percent = (mem_free / mem_total) * 100
    except:
        mem_free_percent = 100.0
    return {"disk_free_gb": round(disk_free_gb, 2), "cpu_load": round(cpu_load, 2), "mem_free_percent": round(mem_free_percent, 2)}

def scrape_metrics():
    cfg = load_manifest()
    port = cfg["nginx"]["port"]
    try:
        with urllib.request.urlopen(f"http://localhost:{port}/metrics", timeout=5) as resp:
            return resp.read().decode()
    except:
        return ""

def parse_metrics(raw):
    total, errors = 0, 0
    for line in raw.splitlines():
        if line.startswith("http_requests_total{"):
            parts = line.rsplit(" ", 1)
            if len(parts) == 2:
                try:
                    count = float(parts[1])
                    total += count
                    if 'status_code="5' in line:
                        errors += count
                except:
                    pass
    error_rate = (errors / total) if total > 0 else 0.0
    p99_ms = 0
    for line in raw.splitlines():
        if "http_request_duration_seconds_bucket" in line and 'le="+Inf"' in line:
            try:
                parts = line.rsplit(" ", 1)
                if len(parts) == 2:
                    pass
            except:
                pass
    return {"total_requests": int(total), "error_requests": int(errors), "error_rate": round(error_rate, 4), "p99_latency_ms": p99_ms}

def check_pre_deploy():
    print("[swiftdeploy] Checking pre-deploy policy...")
    stats = get_host_stats()
    print(f"  Disk: {stats['disk_free_gb']}GB free, CPU: {stats['cpu_load']}, Mem: {stats['mem_free_percent']}%")
    result = query_opa("infrastructure", stats)
    if "error" in result:
        print(f"  [WARN] {result['error']}")
        return True
    if result.get("allow"):
        print("  [PASS] Infrastructure policy OK")
        return True
    print("  [BLOCK] Infrastructure policy failed:")
    for r in result.get("deny_reasons", []):
        print(f"    - {r}")
    return False

def check_pre_promote():
    print("[swiftdeploy] Checking pre-promote policy...")
    raw = scrape_metrics()
    if not raw:
        print("  [WARN] Cannot scrape metrics")
        return True
    m = parse_metrics(raw)
    print(f"  Error rate: {m['error_rate']*100:.2f}%, P99: {m['p99_latency_ms']}ms")
    result = query_opa("canary", m)
    if "error" in result:
        print(f"  [WARN] {result['error']}")
        return True
    if result.get("allow"):
        print("  [PASS] Canary policy OK")
        return True
    print("  [BLOCK] Canary policy failed:")
    for r in result.get("deny_reasons", []):
        print(f"    - {r}")
    return False

def append_history(entry):
    with open(HISTORY_FILE, "a") as f:
        f.write(json.dumps(entry) + "\n")

def cmd_init():
    print("[swiftdeploy] Running init...")
    cfg = load_manifest()
    with open(os.path.join(TEMPLATES_DIR, "nginx.conf.j2")) as f:
        tmpl = Template(f.read())
    with open(NGINX_CONF, "w") as f:
        f.write(tmpl.render(**cfg))
    with open(os.path.join(TEMPLATES_DIR, "docker-compose.yml.j2")) as f:
        tmpl = Template(f.read())
    with open(COMPOSE_FILE, "w") as f:
        f.write(tmpl.render(**cfg))
    print("[swiftdeploy] Init complete")

def cmd_validate():
    print("[swiftdeploy] Running validate...")
    passed, failed = 0, 0
    def check(name, result, msg=""):
        nonlocal passed, failed
        if result:
            print(f"  [PASS] {name}")
            passed += 1
        else:
            print(f"  [FAIL] {name}: {msg}" if msg else f"  [FAIL] {name}")
            failed += 1
    try:
        cfg = load_manifest()
        check("manifest.yaml exists", True)
    except Exception as e:
        check("manifest.yaml exists", False, str(e))
        sys.exit(1)
    check(f"Port {cfg['nginx']['port']} check", True)
    print(f"\n[swiftdeploy] Validation: {passed} passed, {failed} failed")

def cmd_deploy():
    print("[swiftdeploy] Running deploy...")
    cmd_init()
    if not check_pre_deploy():
        print("[swiftdeploy] Deploy blocked by policy")
        sys.exit(1)
    cfg = load_manifest()
    run(f"docker build -t {cfg['services']['image']} {os.path.join(BASE, 'app')}")
    run(f"docker compose -f {COMPOSE_FILE} up -d")
    time.sleep(15)
    print("[swiftdeploy] Deploy complete")
    append_history({"timestamp": datetime.now(timezone.utc).isoformat(), "event": "deploy", "status": "success"})

def cmd_promote(mode):
    print(f"[swiftdeploy] Promoting to {mode}")
    if not check_pre_promote():
        print("[swiftdeploy] Promotion blocked by policy")
        sys.exit(1)
    cfg = load_manifest()
    cfg["app"]["mode"] = mode
    cfg["services"]["env"]["MODE"] = mode
    with open(MANIFEST, "w") as f:
        yaml.dump(cfg, f)
    with open(os.path.join(TEMPLATES_DIR, "docker-compose.yml.j2")) as f:
        tmpl = Template(f.read())
    with open(COMPOSE_FILE, "w") as f:
        f.write(tmpl.render(**cfg))
    run(f"docker compose -f {COMPOSE_FILE} up -d --no-deps app")
    print(f"[swiftdeploy] Promoted to {mode}")
    append_history({"timestamp": datetime.now(timezone.utc).isoformat(), "event": "promote", "mode": mode, "status": "success"})

def cmd_status():
    print("\n" + "="*50)
    print("SwiftDeploy Status Dashboard")
    print("="*50)
    raw = scrape_metrics()
    if raw:
        m = parse_metrics(raw)
        print(f"\n[Requests] Total: {m['total_requests']} | Errors: {m['error_requests']} | Error Rate: {m['error_rate']*100:.2f}%")
    stats = get_host_stats()
    print(f"\n[Host] Disk: {stats['disk_free_gb']}GB | CPU Load: {stats['cpu_load']} | Mem Free: {stats['mem_free_percent']}%")
    infra = query_opa("infrastructure", stats)
    print(f"\n[Infrastructure Policy] {'✓ PASS' if infra.get('allow') else '✗ FAIL'}")
    if not infra.get('allow') and 'deny_reasons' in infra:
        for r in infra['deny_reasons']:
            print(f"    - {r}")
    if raw:
        canary = query_opa("canary", m)
        print(f"\n[Canary Safety Policy] {'✓ PASS' if canary.get('allow') else '✗ FAIL'}")
        if not canary.get('allow') and 'deny_reasons' in canary:
            for r in canary['deny_reasons']:
                print(f"    - {r}")
    append_history({"timestamp": datetime.now(timezone.utc).isoformat(), "metrics": m if raw else {}, "infra_policy": infra.get('allow')})

def cmd_audit():
    if not os.path.exists(HISTORY_FILE):
        print("[swiftdeploy] No history found. Run 'swiftdeploy status' first.")
        return
    lines = ["# SwiftDeploy Audit Report", "", f"Generated: {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')}", "", "## Timeline", ""]
    with open(HISTORY_FILE) as f:
        for line in f:
            if line.strip():
                e = json.loads(line)
                lines.append(f"- {e.get('timestamp')}: {e.get('event')} ({e.get('status', 'ok')})")
    with open(AUDIT_FILE, "w") as f:
        f.write("\n".join(lines))
    print(f"[swiftdeploy] Audit report generated: {AUDIT_FILE}")

def cmd_teardown(clean=False):
    print("[swiftdeploy] Running teardown...")
    if os.path.exists(COMPOSE_FILE):
        run(f"docker compose -f {COMPOSE_FILE} down -v", check=False)
    if clean:
        for f in [NGINX_CONF, COMPOSE_FILE]:
            if os.path.exists(f):
                os.remove(f)
                print(f"[swiftdeploy] Deleted: {f}")
    print("[swiftdeploy] Teardown complete.")

def main():
    args = sys.argv[1:]
    if not args:
        print("Usage: swiftdeploy [init|validate|deploy|promote|status|audit|teardown]")
        sys.exit(1)
    cmd = args[0]
    if cmd == "init": cmd_init()
    elif cmd == "validate": cmd_validate()
    elif cmd == "deploy": cmd_deploy()
    elif cmd == "promote" and len(args) > 1: cmd_promote(args[1])
    elif cmd == "status": cmd_status()
    elif cmd == "audit": cmd_audit()
    elif cmd == "teardown": cmd_teardown(args[1] == "--clean" if len(args) > 1 else False)
    else: print(f"Unknown: {cmd}")

if __name__ == "__main__":
    main()
